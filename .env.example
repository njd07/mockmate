# ─────────────────────────────────────────────────────────────────────────────
# MockMate Environment Variables Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ─── 0. Application URL (Optional, defaults to http://localhost:3000) ───
VITE_APP_URL=http://localhost:3000

# ─── 1. AI Providers (At least one key is recommended for live AI responses) ───
# Groq (Primary — Fastest inference ~500 tok/sec, free at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini (Fallback — Free tier at https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Local Ollama (Optional offline fallback — no key needed, configure via Settings UI)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=mistral:7b-instruct-q3_K_M

# ─── 2. Clerk Authentication (Free at https://dashboard.clerk.com) ───
# Enables Google OAuth & Email sign-in. If omitted, MockMate runs in 1-Click Demo Mode.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# ─── 3. Supabase Database (Free at https://supabase.com) ───
# Persistent Postgres storage. If omitted, MockMate uses local memory persistence.
# Remember to run `supabase/schema.sql` in the Supabase SQL editor!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Optional public anon key
# VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# ─── 4. Stripe Payments (Test Mode at https://dashboard.stripe.com/test) ───
# Freemium Pro subscription test mode. Test card: 4242 4242 4242 4242
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_PRICE_ID=price_your_test_price_id

# Stripe Webhook Secret (from Stripe Dashboard > Developers > Webhooks)
# Webhook URL: https://your-domain.vercel.app/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# ─── 5. Admin Secret (Optional) ───
# Secret key to authorize manual credit adjustments via /api/admin endpoints
ADMIN_API_KEY=mockmate_admin_secret_key
